# [doc (hidden)] # [allow (non_upper_case_globals)] const __RHDL_FSM_VARIANTS_State : [rhdl :: core :: fsm :: FsmVariantDescriptor ; 3usize] = [rhdl :: core :: fsm :: FsmVariantDescriptor { name : "Idle" , discriminant : 0i64 as i128 , has_payload : false , terminal : false , label : None , } , rhdl :: core :: fsm :: FsmVariantDescriptor { name : "Running" , discriminant : 1i64 as i128 , has_payload : true , terminal : false , label : Some ("running, counter = {counter}") , } , rhdl :: core :: fsm :: FsmVariantDescriptor { name : "Done" , discriminant : 2i64 as i128 , has_payload : false , terminal : true , label : Some ("complete") , }] ; # [automatically_derived] impl rhdl :: core :: fsm :: FsmState for State { fn fsm_variants () -> & 'static [rhdl :: core :: fsm :: FsmVariantDescriptor] { & __RHDL_FSM_VARIANTS_State } fn fsm_initial_index () -> usize { 0usize } fn fsm_variant_index (& self) -> usize { match self { State :: Idle => 0usize , State :: Running { .. } => 1usize , State :: Done => 2usize } } }