# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

**/*.vcd.rtt
**/*.vcd
**/*.v

# ...but hand-written Verilog is SOURCE, not output. The rule above
# exists for the testbenches the Tier-4 tests emit into `<crate>/vlog/`,
# and it silently swallowed the plain-Verilog AXI4 protocol monitor --
# the whole independent half of validation Tier A/Tier B -- which would
# have left `tests/axi4_tier_b_monitor.rs` failing on every machine but
# the one it was written on. Hand-written Verilog goes in
# `<crate>/verilog/` precisely so the two can be told apart.
!**/verilog/**/*.v

# Added by cargo

/target

# Reference assets downloaded from third-party archives
# (e.g., Xerox Alto microcode/disk images from bitsavers.org).
# Cached locally for development; not part of the repo.
/assets/
